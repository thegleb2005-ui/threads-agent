# --- Telegram ---
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Твой числовой Telegram user_id (узнать у @userinfobot). Только этот
# пользователь сможет управлять агентом.
ADMIN_USER_ID=

# --- kie.ai: используется и для транскрибации, и для генерации текста поста ---
KIE_API_KEY=
KIE_BASE_URL=https://api.kie.ai/v1
KIE_MODEL=gpt-5-2

# Движок распознавания речи: "elevenlabs" (по умолчанию, через очередь задач)
# или "gemini" (эксперимент — один синхронный запрос, может быть надёжнее)
TRANSCRIBE_PROVIDER=elevenlabs
GEMINI_MODEL=gemini-2.5-flash

# --- Threads (Meta Graph API) — НЕ обязательны для запуска бота сейчас,
#     публикация ручная. Понадобятся только если включишь автопубликацию
#     позже (см. README, "Как включить автопубликацию"). Можно оставить пустыми. ---
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
POST_TIMES=09:00,14:00,19:00

# --- Стиль контента ---
POST_LANGUAGE=English
POST_STYLE_PROMPT=

# --- Пути (можно не менять) ---
DB_PATH=agent.db
DOWNLOADS_DIR=downloads
