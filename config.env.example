# --- Telegram ---
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Твой числовой Telegram user_id (узнать у @userinfobot). Только этот
# пользователь сможет управлять агентом.
ADMIN_USER_ID=

# --- kie.ai: используется только для генерации текста поста (не для
#     транскрибации — та теперь по умолчанию работает локально) ---
KIE_API_KEY=
KIE_BASE_URL=https://api.kie.ai/v1
KIE_MODEL=gpt-5-2

# Движок распознавания речи: "local" (по умолчанию — Whisper прямо на
# сервере, без сети и без ключей), "elevenlabs" или "gemini" (оба через
# kie.ai — оставлены как запасные варианты, см. README)
TRANSCRIBE_PROVIDER=local
WHISPER_MODEL_SIZE=base
# Таймаут на распознавание одного 10-минутного куска в отдельном процессе,
# прежде чем считать его зависшим (сек). Увеличь, если сервер медленный.
WHISPER_SUBPROCESS_TIMEOUT=900
GEMINI_MODEL=gemini-2.5-flash

# --- Threads (Meta Graph API) — НЕ обязательны для запуска бота сейчас,
#     публикация ручная. Понадобятся только если включишь автопубликацию
#     позже (см. README, "Как включить автопубликацию"). Можно оставить пустыми. ---
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
POST_TIMES=09:00,14:00,19:00

# --- Стиль контента ---
POST_LANGUAGE=English
POST_STYLE_PROMPT=

# --- Пути (можно не менять) ---
DB_PATH=agent.db
DOWNLOADS_DIR=downloads

# --- Распознавание: экономия памяти (бот и коннектор делят 1 ГБ) ---
# WHISPER_BEAM_SIZE=1
# WHISPER_CPU_THREADS=2
# WHISPER_CHUNK_SECONDS=300
# Для YouTube сразу делать расшифровку на русском (false — спрашивать, как для остальных)
# YOUTUBE_DEFAULT_TRANSCRIPT=true
# YouTube cookies в base64 (см. README коннектора)
# COOKIES_B64=

# --- Многопользовательский режим ---
# Пусто — бот открыт для всех. Иначе — Telegram ID через запятую
# ALLOWED_USERS=
# Видео в сутки на человека (0 — без лимита; на ADMIN_USER_ID не действует)
# DAILY_LIMIT_PER_USER=20
# Сколько видео человек может держать в работе одновременно
# MAX_QUEUED_PER_USER=3
# Сколько видео скачивать параллельно
# MAX_PARALLEL_DOWNLOADS=2
# Для YouTube сначала брать субтитры, Whisper — только если их нет
# USE_YOUTUBE_SUBTITLES=true
# Для Instagram Reels сразу делать пост по промпту
# INSTAGRAM_DEFAULT_POST=true
# INSTAGRAM_DEFAULT_PROMPT=Сделай пост для тредс на английском языке по этому рилс
